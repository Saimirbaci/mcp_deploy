{
  "servers": {
    "[IP_ADDRESS]": {
      "alias": "local_vm",
      "user": "user_name",
      "key_path": "/Users/user_name/.ssh/id_rsa",
      "db_config": {
        "user": "postgres",
        "name": "auto_finanza",
        "password": "your_password",
        "readonly": false
      },
      "allowed_command_prefixes": [
        "ls",
        "tail -n",
        "systemctl status",
        "uptime"
      ]
    }
  }
}